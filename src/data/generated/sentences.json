[{"es":"Todos vamos a hacer eso.","en":"We're all going to do that.","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10004463 (CK) & #10004479 (arh)"},{"es":"¿Dónde están tus hijos ahora?","en":"Where are your children now?","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #5881805 (astru) & #10006642 (arh)"},{"es":"No sabes cómo hacerlo, ¿verdad?","en":"You don't know how to do it, do you?","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #954745 (CK) & #1001038 (Shishir)"},{"es":"Aquí no puedes hacer eso.","en":"You can't do that here.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #954734 (CK) & #1001041 (Shishir)"},{"es":"Nunca quisiste ser mi amigo.","en":"You never wanted to be my friend.","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10016208 (DJ_Saidez) & #10016156 (Shishir)"},{"es":"¿Qué crees que estoy pensando?","en":"What do you think I'm thinking about?","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #7791297 (shekitten) & #10016160 (Shishir)"},{"es":"Perdona, pero ¿tú quién eres?","en":"I'm sorry. Who are you?","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10481409 (DJ_Saidez) & #10016296 (Shishir)"},{"es":"No te tienes que ir.","en":"You don't have to leave.","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #2645137 (CK) & #10022625 (arh)"},{"es":"Ese no es tu libro.","en":"That isn't your book.","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10024760 (CK) & #10025275 (manufrutos)"},{"es":"¿Puedo quedarme aquí esta noche?","en":"Can I stay here tonight?","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #1003115 (ellasevia) & #1003119 (Shishir)"},{"es":"¿Tiene algún problema con eso?","en":"Do you have any trouble with that?","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #50478 (CK) & #1003181 (hayastan)"},{"es":"Él no sabe qué hacer.","en":"He doesn't know what to do.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #717764 (CM) & #1003264 (hayastan)"},{"es":"Estamos viviendo con nuestro tío.","en":"We're living with our uncle.","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10043457 (CK) & #10044274 (manufrutos)"},{"es":"Queda un poco de leche.","en":"There's a bit of milk left.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #9140255 (sundown) & #10044446 (manufrutos)"},{"es":"También me gusta beber leche.","en":"I also love drinking milk.","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #9065990 (ajaystxus) & #10044455 (manufrutos)"},{"es":"¿Te gusta el chocolate caliente?","en":"Do you like hot chocolate?","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10050862 (ddnktr) & #10051307 (manufrutos)"},{"es":"¿Os gusta el chocolate caliente?","en":"Do you like hot chocolate?","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10050862 (ddnktr) & #10051308 (manufrutos)"},{"es":"Nadie recuerda cómo empezó todo.","en":"Nobody remembers how it all began.","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10075936 (CK) & #10060859 (manufrutos)"},{"es":"Está empezando a hacer frío.","en":"It's starting to get cold.","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #8238573 (josivangoncalves) & #1006282 (Shishir)"},{"es":"No me salen las palabras.","en":"I'm lost for words.","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10065083 (DJ_Saidez) & #10065082 (DJ_Saidez)"},{"es":"¿De quién son las llaves?","en":"Who do the keys belong to?","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10064923 (meshbags) & #10065201 (manufrutos)"},{"es":"Nadie sabe quién es él.","en":"Nobody knows who he is.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10064898 (meshbags) & #10065235 (manufrutos)"},{"es":"Pero no lo puede hacer.","en":"But he can't do it.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #11410645 (DJ_Saidez) & #10068902 (Shishir)"},{"es":"Tengo que irme a trabajar.","en":"I have to go work.","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10069812 (DJ_Saidez) & #10069779 (Shishir)"},{"es":"¿Qué te está poniendo triste?","en":"What's making you sad?","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10087900 (CK) & #10078863 (manufrutos)"},{"es":"Nuestra casa es tu casa.","en":"Our house is your house.","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #456569 (lukaszpp) & #1008480 (Shishir)"},{"es":"Nuestra casa es vuestra casa.","en":"Our house is your house.","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #456569 (lukaszpp) & #1008481 (Shishir)"},{"es":"Quería venir a las nueve.","en":"I wanted to come at nine.","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #9741274 (DJ_Saidez) & #10085675 (DJ_Saidez)"},{"es":"No sé lo que quieres.","en":"I don't know what you want.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #1887252 (CK) & #10086798 (saverius)"},{"es":"Mis gatos son mis hijos.","en":"My cats are my children.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10090762 (shekitten) & #10090864 (manufrutos)"},{"es":"Sé que no puedes verlo.","en":"I know you can't see him.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10090698 (shekitten) & #10090886 (manufrutos)"},{"es":"Mis gatas son mis hijas.","en":"My cats are my children.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10090762 (shekitten) & #10091131 (manufrutos)"},{"es":"No he hecho eso hoy.","en":"I haven't done that today.","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10092431 (ddnktr) & #10092964 (manufrutos)"},{"es":"Estuve en su casa ayer.","en":"I was at his house yesterday.","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10087186 (ddnktr) & #10093068 (manufrutos)"},{"es":"Sé que no me quieren.","en":"I know they don't love me.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10087034 (ddnktr) & #10093101 (manufrutos)"},{"es":"¿Cuándo se escribió este libro?","en":"When was this book written?","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10093033 (ddnktr) & #10093214 (manufrutos)"},{"es":"¿Le dijeron eso a ella?","en":"Did they say that to her?","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10069705 (ddnktr) & #10093279 (manufrutos)"},{"es":"Quiero un perro como ese.","en":"I want a dog like that one.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10095819 (CK) & #10097453 (manufrutos)"},{"es":"Se ha ido la luz.","en":"The power went out.","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #480240 (minshirui) & #1010771 (hundo)"},{"es":"Creí que no querías venir.","en":"I thought you didn't want to come.","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #1011060 (Narda) & #1011057 (Narda)"},{"es":"Creía que no querías venir.","en":"I thought you didn't want to come.","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #1011060 (Narda) & #1011430 (Shishir)"},{"es":"¿Lo dices porque tienes miedo?","en":"Do you say that because you're afraid?","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #873827 (\\N) & #1011525 (Shishir)"},{"es":"Él escribió a sus padres.","en":"He wrote to his parents.","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #304723 (CK) & #1012266 (hundo)"},{"es":"Estamos yendo a las montañas.","en":"We're going to the mountains.","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #6874225 (CK) & #10124597 (manufrutos)"},{"es":"Nuestra tienda no está abierta.","en":"Our store isn't open.","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #5315405 (Objectivesea) & #10124647 (manufrutos)"},{"es":"No vivo en la ciudad.","en":"I don't live in the city.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #5190371 (CK) & #10124688 (manufrutos)"},{"es":"Yo escribo lo que quiero.","en":"I write what I want.","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #12903716 (araneo) & #10132803 (saverius)"},{"es":"No se olvidó de nosotros.","en":"He didn't forget us.","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10159763 (shekitten) & #10159831 (carlosalberto)"},{"es":"Compré media docena de huevos.","en":"I bought half a dozen eggs.","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #262181 (adjusting) & #1016033 (hayastan)"},{"es":"No puedo abrir esta puerta.","en":"I can't open this door.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #5850964 (CK) & #10160957 (Shishir)"},{"es":"Puedo venderte esto si quieres.","en":"I can sell this for you if you want me to.","ch":3,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10167444 (CK) & #10170411 (manufrutos)"},{"es":"Es lo que hacen todos.","en":"That's what everyone does.","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #2677081 (Hybrid) & #10185750 (Seael)"},{"es":"¿Quién se bebió el agua?","en":"Who drank the water?","ch":5,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10181761 (ddnktr) & #10188647 (Shishir)"},{"es":"Ella tiene los pies pequeños.","en":"She has small feet.","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #315604 (CK) & #1020475 (Shishir)"},{"es":"No me gusta la leche.","en":"I don't like milk.","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #5975635 (CK) & #10205525 (Shishir)"},{"es":"Ahora le toca a usted.","en":"Now it's your turn.","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #3519569 (CK) & #10215740 (JSKabylie)"},{"es":"¿Qué le vas a dar?","en":"What will you give her?","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #2785993 (mervert1) & #1021881 (Shishir)"},{"es":"¿También le gustas a él?","en":"Does he like you, too?","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #8078711 (Hybrid) & #10242803 (ecorralest101)"},{"es":"Nos hemos quedado sin patatas.","en":"We're out of potatoes.","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10245117 (sundown) & #10245127 (Seael)"},{"es":"Aquí no conoces a nadie.","en":"You don't know anyone here.","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #2543890 (CK) & #10274439 (Shishir)"},{"es":"¿Vives también en esta calle?","en":"Do you live on this street, too?","ch":4,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10259589 (bekindtoall) & #10274485 (manufrutos)"},{"es":"Yo no quiero comer aquí.","en":"I don't want to eat here.","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #953443 (CK) & #1031898 (jayefes65)"},{"es":"Ella no come ni bebe.","en":"She doesn't eat or drink.","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #9668362 (DJ_Saidez) & #1033009 (Shishir)"},{"es":"¿Es todo lo que hay?","en":"Is it all that's there?","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #11918702 (raonicalias) & #10346723 (JSKabylie)"},{"es":"El cielo está sobre mí.","en":"The sky is above me.","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #4457745 (LB) & #10349031 (Seael)"},{"es":"Voy a escribir de esto.","en":"I'll write about this.","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #5257457 (CarpeLanam) & #10363357 (DJ_Saidez)"},{"es":"¿Por qué tienes que hacerlo?","en":"Why do you have to do it?","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #716107 (papabear) & #1045971 (Shishir)"},{"es":"Ellas quieren hablar con usted.","en":"They want to speak with you.","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10458478 (tchrspet1) & #10461298 (Vickypitti)"},{"es":"Ella tiene que beber agua.","en":"She has to drink water.","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #2896413 (abburns) & #10496374 (Shishir)"},{"es":"¿No quiere hablar con ellos?","en":"Don't you want to talk to them?","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #3906393 (CH) & #10508334 (Seael)"},{"es":"¿No queréis hablar con ellos?","en":"Don't you want to talk to them?","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #3906393 (CH) & #10508335 (Seael)"},{"es":"¿No quieres hablar con ellos?","en":"Don't you want to talk to them?","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #3906393 (CH) & #10508336 (Seael)"},{"es":"Las uvas son como huevos.","en":"Grapes are like eggs.","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10515747 (DJ_Saidez) & #10514934 (Seael)"},{"es":"Cuatro por cinco es veinte.","en":"Four times five is twenty.","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #72538 (CK) & #1068498 (hayastan)"},{"es":"Todas las manzanas están aquí.","en":"All the apples are here.","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #4719034 (AlanF_US) & #10727034 (Seael)"},{"es":"Este libro se vende bien.","en":"This book sells well.","ch":1,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #56999 (Dejo) & #1077062 (Shishir)"},{"es":"Estamos vendiendo zumo de naranja.","en":"We are selling orange juice.","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10943176 (Mayk) & #10943185 (Seael)"},{"es":"No quiero hablar de ello.","en":"I don't want to talk about it.","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #1096472 (CK) & #1099658 (Shishir)"},{"es":"Ella no come carne, ¿verdad?","en":"She doesn't eat meat, does she?","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #1127848 (CH) & #1128290 (cueyayotl)"},{"es":"¿Ella trabaja en la cocina?","en":"Does she work in the kitchen?","ch":2,"src":"CC-BY 2.0 (France) Attribution: tatoeba.org #315658 (CH) & #1144113 (Shishir)"},{"es":"Que no se te olvide nada.","en":"Don't forget anything.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #1624921 (marcelostockle) & #1624737 (marcelostockle)"},{"es":"¡No te olvides de mí!","en":"Don't forget me!","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #3626477 (karloelkebekio) & #2479378 (marcelostockle)"},{"es":"¡No os olvidéis de nosotros!","en":"Don't forget us!","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #578776 (langulo) & #940079 (Shishir)"},{"es":"¡No te olvides de nosotros!","en":"Don't forget us!","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #578776 (langulo) & #3025 (Shishir)"},{"es":"¡Que todo el mundo salga, rápido!","en":"Everybody out, quickly!","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #10465382 (DJ_Saidez) & #9985162 (Shishir)"},{"es":"Bueno. ¡Que te vaya bien!","en":"Sure. Good luck!","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #4431177 (Vortarulo) & #336540 (kylecito)"},{"es":"Como sea, nunca lo sabrás.","en":"Anyway, you'll never know.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #63264 (CK) & #7310260 (dfrankmv)"},{"es":"¿Hay algo que pueda hacer?","en":"Can I do anything?","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #250046 (CK) & #2266432 (marcelostockle)"},{"es":"¿Hay algo que pueda hacer yo?","en":"Can I do anything?","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #250046 (CK) & #1344429 (Shishir)"},{"es":"¿Hay algo que yo pueda hacer?","en":"Can I do anything?","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #250046 (CK) & #3446352 (marcelostockle)"},{"es":"No lo vuelvas a comprar.","en":"Don't buy it again.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #9496000 (DJ_Saidez) & #7359694 (arh)"},{"es":"No me vuelvas a llamar.","en":"Don't call me again.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #1845517 (CK) & #2219493 (Shishir)"},{"es":"No lo vuelvas a hacer.","en":"Don't do it again.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #2235209 (Hybrid) & #2246917 (Shishir)"},{"es":"No te olvides de mí.","en":"Don't forget about me.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #1453887 (CK) & #1453899 (marcelostockle)"},{"es":"¡No se olvide de nosotros!","en":"Don't forget about us!","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #2216 (CK) & #1199305 (cariito)"},{"es":"No le digas esto a nadie.","en":"Don't tell anyone this.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #529830 (CK) & #3983710 (senryakun)"},{"es":"No me lo vuelvas a decir.","en":"Don't tell me again.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #8422054 (magnificentgoddess) & #6591658 (arh)"},{"es":"No se lo digas a tu padre.","en":"Don't tell your dad.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #1740925 (Spamster) & #1740943 (hayastan)"},{"es":"No se lo digáis a vuestra madre.","en":"Don't tell your mother.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #1740924 (Spamster) & #1741734 (Shishir)"},{"es":"No se lo digas a tu madre.","en":"Don't tell your mother.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #1740924 (Spamster) & #1741733 (Shishir)"},{"es":"No me toques los huevos.","en":"Don't touch my balls.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #4823569 (whitefishglobal) & #10805426 (saverius)"},{"es":"Él irá a la ciudad.","en":"He'll go to town.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #3366448 (Jesse) & #3506274 (cueyayotl)"},{"es":"Él no se lo creerá.","en":"He won't believe it.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #1871777 (Spamster) & #1876066 (Shishir)"},{"es":"Querría un poco de queso.","en":"I'd like some cheese.","ch":1,"lvl":"b1","src":"CC-BY 2.0 (France) Attribution: tatoeba.org #40281 (Swift) & #3197651 (Shishir)"}]
